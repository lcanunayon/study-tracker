{
  "name": "study-tracker",
  "version": "0.1.0",
  "description": "A beautiful and efficient study tracking desktop application",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "tsc -p tsconfig.main.json --watch & esbuild src/renderer/app.ts --bundle --platform=browser --target=chrome108 --outfile=dist/renderer/app.js --watch",
    "build": "npm run build:frontend && npm run electron:build",
    "build:frontend": "tsc -p tsconfig.main.json && node scripts/copy-static.js && esbuild src/renderer/app.ts --bundle --platform=browser --target=chrome108 --outfile=dist/renderer/app.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "firebase": "^12.11.0"
  },
  "build": {
    "appId": "com.studytracker.app",
    "productName": "Study Tracker",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
